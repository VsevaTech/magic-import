# Copy to .env and adjust. Everything is optional.

# Where SQLite + temporary uploads live (Docker mounts a volume here)
DATA_DIR=./data

# Delete the raw uploaded file as soon as it has been parsed (default: true).
# Multi-sheet XLSX files are kept until the mapping is confirmed so you can switch sheet.
DELETE_UPLOADS_AFTER_PROCESSING=true
UPLOAD_RETENTION_HOURS=24
MAX_UPLOAD_MB=20

# Optional AI-assisted mapping (Google Gemini). Leave empty to run fully offline.
# Only column names + a few masked sample values are ever sent, and only for
# columns the deterministic mapper could not resolve.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
